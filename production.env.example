# Copy to production.env and replace every required value.
MASKGATE_API_KEYS=replace-with-long-random-inbound-key
TRUSTED_HOSTS=maskgate.example.com

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-with-provider-key
LLM_DEFAULT_MODEL=provider-model
DETECTOR_PROFILE=strict
# Mount and set a Policy v2 path only after reviewing the strict schema.
POLICY_V2_FILE=
MASKGATE_APPLICATION_ID=maskgate
MASKGATE_JURISDICTION=unspecified
MASKGATE_DEFAULT_PURPOSE=remote_llm_processing

BIND_HOST=127.0.0.1
APP_PORT=8080
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
STRICT_MEDIA_MEMORY=true
OPERATION_TIMEOUT_SECONDS=130
CONVERSATION_LOCK_TIMEOUT_SECONDS=10
ADMISSION_GLOBAL_MAX_OPERATIONS=32
ADMISSION_PRINCIPAL_MAX_OPERATIONS=4
ADMISSION_GLOBAL_MAX_BYTES=402653184
ADMISSION_PRINCIPAL_MAX_BYTES=67108864
ADMISSION_OPERATION_MAX_BYTES=33554432
CONVERSATION_GLOBAL_MAX_BYTES=67108864
CONVERSATION_PRINCIPAL_MAX_BYTES=16777216
LOG_LEVEL=INFO
MEMORY_LIMIT=2g
CPU_LIMIT=2.0
