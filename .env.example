APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8080

# Optional inbound proxy authentication. Use a long random value in production.
# Multiple active rotation keys may be comma-separated.
MASKGATE_API_KEYS=
REQUIRE_AUTH=false
MAX_REQUEST_BODY_BYTES=1048576
MAX_MEDIA_FILE_BYTES=10485760
MEDIA_MAX_CONCURRENCY=2
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_HOSTS=localhost,127.0.0.1

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=provider-model
UPSTREAM_TIMEOUT_SECONDS=120
MAX_UPSTREAM_RESPONSE_BYTES=8388608

MASKING_MODE=placeholder
DETECTOR_PROFILE=strict
MAPPING_TTL_SECONDS=3600
CONVERSATION_MAX_MAPPINGS=5000
CONVERSATION_MAX_SENSITIVE_BYTES=2097152

# Optional strict contextual policy. See docs/policy-schema-v2.example.yaml.
POLICY_V2_FILE=
MASKGATE_APPLICATION_ID=maskgate
MASKGATE_JURISDICTION=unspecified
MASKGATE_DEFAULT_PURPOSE=remote_llm_processing

# Conversation memory stays in RAM and expires automatically.
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_MESSAGES=40
CONVERSATION_MAX_CHARS=120000
CONVERSATION_MAX_COUNT=1000

ENABLE_DEBUG_ENDPOINTS=false
ENABLE_PLAYGROUND=true
LOG_LEVEL=INFO

BLOCK_API_KEYS=true
BLOCK_SECRETS=true
BLOCK_CREDIT_CARDS=false
